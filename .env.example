# -----------------------------------------------------------------------------
# Cockpit-G2 Environment Configuration
# Copy to .env and fill in credentials. Never commit .env.
# -----------------------------------------------------------------------------

# Run without live external API calls (deterministic local router + retrieval)
# Set to false once OPENROUTER_API_KEY is configured.
COCKPIT_MOCK_MODE=true

# Backend server
COCKPIT_HOST=127.0.0.1
COCKPIT_PORT=8000
COCKPIT_DB_PATH=backend/data/cockpit.db
COCKPIT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OpenRouter (Core Track 4 integration: STT + Jev System-1 router + LLM synthesis)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api
OPENROUTER_JEV_MODEL=typesafe/jev-latest
OPENROUTER_STT_MODEL=openai/whisper-1
OPENROUTER_LLM_MODEL=anthropic/claude-haiku-4.5

# Notion (Core Track 4 integration: live research journal & multi-mind inbox)
# Leave blank to run SQLite-only until Notion databases are connected.
NOTION_TOKEN=
NOTION_LOG_DATABASE_ID=
NOTION_HOLDINGS_DATABASE_ID=
